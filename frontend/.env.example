# Base URL of the deployed API Gateway stage (see infra/stacks/api_stack.py's
# ApiUrl output), no trailing slash. Copy this file to .env for local dev:
#
#   export API_URL=$(aws cloudformation describe-stacks \
#       --stack-name SpaceWeather-Api-dev --profile sw-bootstrap \
#       --query "Stacks[0].Outputs[?OutputKey=='ApiUrl'].OutputValue" --output text)
#   echo "VITE_API_BASE_URL=$API_URL" > .env
VITE_API_BASE_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/v1
